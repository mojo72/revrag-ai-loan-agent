# Server-side secrets (set in Vercel > Project > Settings > Environment Variables, or in .env.local for dev)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
MURF_API_KEY=

# Optional tuning
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=low
# AGENT_FALLBACKS=on
# MURF_VOICE_ID=en-IN-isha
# MURF_LOCALE=en-IN
# DEEPGRAM_MODEL=nova-3

# Client-side (exposed to the browser by design; RevRag keys are publishable SDK keys)
VITE_REVRAG_API_KEY=
