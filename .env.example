# Server-side secrets (set in Vercel > Project > Settings > Environment Variables, or in .env.local for dev)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
MURF_API_KEY=

# Optional tuning
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=low
# AGENT_FALLBACKS=on
# MURF_VOICE_ID=hi-IN-khyati
